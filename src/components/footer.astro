---
import { getTranslatedDataForCurrentLocaleOrThrow } from '../hooks/getTranslatedData';

interface FooterContent {
	address: { line1: string; line2: string; line3: string };
	registry: { krs: string; nip: string; regon: string };
	links: { label: string; href: string }[];
	copyrightHolder: string;
	copyrightNotice: string;
}

const content = await getTranslatedDataForCurrentLocaleOrThrow<FooterContent>('footer', Astro);
---

<div
    class="relative mt-24 md:mt-96 w-full md:h-44 p-4 owo-bg text-owopurple-700 flex items-center justify-center">
  <img src="/assets/logo-bottom.svg" alt="Logo" loading="lazy"
       class="/*absolute*/ fixed w-full max-w-[36rem] right-0 bottom-0 z-0">

  <img src="/assets/logo-bottom.svg" alt="Logo" loading="lazy"
       class="/*absolute*/ fixed w-full opacity-10 max-w-[69rem] right-0 bottom-0 z-0">

  <div class='-top-[40px] h-[30px] bg-left bg-contain absolute bg-[url("/public/assets/dragon_egg.webp")] bg-repeat-x w-full'/>

  <div class="flex flex-col md:flex-row gap-6 md:gap-0 grow justify-around z-10">
    <div>
      <p class="font-extrabold text-center md:text-start">
        {content.address.line1}<br/>
        {content.address.line2}<br/>
        {content.address.line3}
      </p>
    </div>
    <div>
      <p class="font-extrabold text-center md:text-start">
        KRS&nbsp;{content.registry.krs}<br/>
        NIP&nbsp;{content.registry.nip}<br/>
        REGON&nbsp;{content.registry.regon}
      </p>
    </div>
    <div>
      <p class="font-extrabold text-center md:text-start">
        {content.links.map((link, index) => (
          <>
            <a class="underline hover:text-owopurple-500" href={link.href}>{link.label}</a>
            {index < content.links.length - 1 && <br/>}
          </>
        ))}
      </p>
    </div>
    <div class="text-center md:text-start flex items-center justify-center">
      <p class="font-extrabold opacity-100">©&nbsp;{new Date().getFullYear()}&nbsp;{content.copyrightHolder}<br/>{content.copyrightNotice}</p>
    </div>
  </div>
</div>