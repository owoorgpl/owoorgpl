---
import type { ComponentProps } from 'astro/types';
import HtmlPanel from '../components/html-panel.astro';
import Links from '../components/links.astro';
import Page from '../components/page.astro';
import { getTranslatedComponentForCurrentLocaleOrThrow } from '../hooks/getTranslatedComponent';
import Staff from '../components/staff-list.astro';
import TopMenu from '../components/top-menu.astro';
import { getTranslatedDataForCurrentLocaleOrThrow } from '../hooks/getTranslatedData';
import Layout from '../layouts/layout.astro';

type LinksPropType = ComponentProps<typeof Links>['links'];
type StaffPropType = ComponentProps<typeof Staff>['people'];

const [pageData, socialsData, linksData, boardData, comitteeData, Payment, SiteDescription] =
	await Promise.all([
		getTranslatedDataForCurrentLocaleOrThrow<Record<string, string>>(
			'index-page',
			Astro,
		),
		getTranslatedDataForCurrentLocaleOrThrow<LinksPropType>(
			'socials',
			Astro,
		),
		getTranslatedDataForCurrentLocaleOrThrow<LinksPropType>('links', Astro),
		getTranslatedDataForCurrentLocaleOrThrow<StaffPropType>('board', Astro),
		getTranslatedDataForCurrentLocaleOrThrow<StaffPropType>(
			'comittee',
			Astro,
		),
		getTranslatedComponentForCurrentLocaleOrThrow(
			'payment',
			Astro,
		),
		getTranslatedComponentForCurrentLocaleOrThrow(
			'site-description',
			Astro,
		),
	]);
---

<Layout title={pageData['pageTitle']}>
	<TopMenu />
	<Page>
		<div
			class="h-full flex-grow flex flex-col items-center justify-center bg-gradient-to-tr from-owopurple-800 to-owopurple-500"
		>
			<img
				src="/assets/logo.svg"
				alt="Logo"
				class="max-w-[38rem] w-full px-4 animate-in slide-in-from-bottom fade-in-0 duration-1000 delay-75"
			/>
			<p
				class="mt-6 mv-7 p-2 tracking-wider font-bold text-3xl xs:text-4xl sm:text-5xl lg:text-6xl text-center animate-in fade-in duration-700 animation-delay-[0.75s] fill-mode-both"
			>
				{pageData['supportingFurculture']}
			</p>
		</div>
		<div
			class="absolute w-full bottom-4 flex flex-row justify-center items-center sm:flex animation-delay-1500 animate-in slide-in-from-bottom fade-in-0 duration-700 fill-mode-backwards"
		>
			<a
				class="ml-auto mr-auto hover:scale-105 transition duration-100h"
				href="#start"
			>
				<img
					src="/assets/icons/arrow-down.svg"
					alt="Arrow Down Icon"
					class="w-12 animate-bounce"
				/>
			</a>
		</div>
	</Page>
	<div id="start" class="mb-32"></div>

	<SiteDescription />

	<!-- <Page id="start">
      <div class="h-full flex flex-col items-center justify-center">
        <h1 class="bg-amber-700 p-2 font-bold">Second Page</h1>
      </div>
    </Page> -->

	<div id="social-media" class="mb-24"></div>
	<h2
		class="text-center font-bold text-3xl md:text-4xl uppercase mb-4 text-owowhite p-4"
	>
		{pageData['whereToFindUs']}
	</h2>
	<Links links={socialsData} />

	<div id="links" class="mb-24"></div>
	<HtmlPanel>
		<div class="flex flex-col justify-center items-center">
			<h2
				class="text-center font-bold text-3xl md:text-4xl uppercase mb-4"
			>
				{pageData['importantLinks']}
			</h2>
			<Links negative links={linksData} />
		</div>
	</HtmlPanel>

	<div id="stuff" class="pt-24 flex flex-col gap-24 mb-24">
		<Staff people={boardData} title={pageData['boardTitle']} />
		<Staff people={comitteeData} title={pageData['committeeTitle']} />
	</div>

	<div id="payment" class="mx-auto">
		<Payment />
	</div>
</Layout>
