---
import { getTranslatedComponentForCurrentLocaleOrThrow } from '../hooks/getTranslatedComponent';
import { getTranslatedDataForCurrentLocaleOrThrow } from '../hooks/getTranslatedData';
import Layout from '../layouts/layout.astro';

type PolicyPageData = {
	pageTitle: string;
};

const pageData = await getTranslatedDataForCurrentLocaleOrThrow<PolicyPageData>('policy-page', Astro);
const PolicyComponent = await getTranslatedComponentForCurrentLocaleOrThrow('policy', Astro);
---

<Layout title={pageData['pageTitle']}>
	<PolicyComponent />
</Layout>